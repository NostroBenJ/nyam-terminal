{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NYAM Terminal",
  "version": "0.1.0",
  "identifier": "com.nyam.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NYAM Terminal",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 620,
        "theme": "Dark",
        "backgroundColor": "#0a0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../engine/dist/nyam-engine/": "engine/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
