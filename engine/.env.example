# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Read by config._load_dotenv() at engine startup. A real environment variable
# of the same name always wins, so you can override any of these for one run.
#
# Secrets live here rather than in a machine-wide environment variable: a user
# env var is readable by every process you run, which is a wide blast radius
# for a key only this app needs. It also travels with the deployed app folder,
# so a packaged build needs no separate setup.

# Enables the in-app chat and the written brief. Without it the app runs fine
# and falls back to a templated brief.
ANTHROPIC_API_KEY=

# Real-time chains, day-over-day OI, flow alerts, dark pool.
# Probe tier coverage before trusting it:  python -m data.unusual_whales probe SPY
UW_API_KEY=

# Data mode. Default is mock: synthetic, offline, no keys, no cost.
# NYAM_MOCK=0
# NYAM_PROVIDER=yahoo     # or "uw" once UW_API_KEY is set
